# ==============================================================================
# LEGACY LEDGER - ENVIRONMENT VARIABLES TEMPLATE
# Instructions: Copy this file, rename it to '.env', and fill in the actual values.
# DO NOT commit your actual '.env' file to version control (GitHub).
# ==============================================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=5000
JWT_SECRET=

# --- Database Configuration ---
DATABASE_URL=
DATABASE_SSL=true
DB_REJECT_UNAUTHORIZED=false

# --- AI Integrations ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- External Market APIs ---
YAHOO_API_KEY_OR_EMPTY=
TWELVEDATA_API_KEY=

# --- Monitoring & Payments (Optional/Future-proofing) ---
SENTRY_DSN=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=